{
  "expo": {
    "name": "premiumverific",
    "slug": "getpremuimverific",
    "owner": "student-admin",
    "scheme": "premiumverify",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premiumverify.app"
    },
    "android": {
      "package": "com.premiumverify.app",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "premiumverific.com", "path": "/auth/mobile-callback" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.SEND_SMS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#ffffff" }
    },
    "extra": {
      "eas": {
        "projectId": "c0d05158-6d75-4762-bdbc-1e48ff1c3cc3"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
